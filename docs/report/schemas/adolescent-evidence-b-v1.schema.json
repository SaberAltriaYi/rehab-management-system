{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rehab.local/adolescent-evidence-b-v1.schema.json",
  "title": "Adolescent B report evidence package — draft structural contract",
  "description": "Structural exchange format only: source reference integrity, conflict review, source freeze and signature permissions require separate server checks.",
  "type": "object",
  "maxProperties": 32,
  "required": ["schema", "case_ref", "assessment", "sources", "measurements", "observations", "conflicts", "interpretations", "qei", "safety", "risks", "kpis", "review"],
  "properties": {
    "schema": {"const": "ADOLESCENT_EVIDENCE_B_V1_DRAFT"},
    "case_ref": {"type": "string", "minLength": 1, "maxLength": 64, "description": "De-identified internal reference; never patient name or contact details."},
    "assessment": {
      "type": "object",
      "required": ["id", "date", "locked_revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "date": {"$ref": "#/$defs/date"},
        "locked_revision": {"type": "string", "pattern": "^[1-9][0-9]{0,17}$"},
        "stage": {"type": "string"},
        "episode_ref": {"type": "string"},
        "protocol_versions": {"type": "object"}
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["source_id", "type", "capture_date", "method", "permission_scope"],
        "properties": {
          "source_id": {"$ref": "#/$defs/sourceId"},
          "type": {"enum": ["RAW_DATA", "ONSITE_OBSERVATION", "DEVICE_ALGORITHM", "FUNCTIONAL_INFERENCE", "MEDICAL_IMAGING", "WORKING_HYPOTHESIS"]},
          "capture_date": {"$ref": "#/$defs/date"},
          "method": {"type": "string", "minLength": 1},
          "permission_scope": {"type": "string", "minLength": 1},
          "unit": {"type": "string"},
          "side": {"type": "string"},
          "task": {"type": "string"},
          "device_version": {"type": "string"},
          "file_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    },
    "measurements": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["source_id", "validity"],
        "properties": {
          "source_id": {"$ref": "#/$defs/sourceId"},
          "validity": {"enum": ["VALID", "INVALID", "FAILED", "NOT_TESTED", "PLACEHOLDER"]},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string"},
          "missing_reason": {"type": "string"},
          "task": {"type": "string"},
          "side": {"type": "string"},
          "phase": {"type": "string"},
          "reliability": {"type": "string"},
          "method_version": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"validity": {"const": "VALID"}}, "required": ["validity"]},
            "then": {"required": ["value", "unit"], "properties": {"value": {"type": "number"}, "unit": {"minLength": 1}}}
          },
          {
            "if": {"properties": {"validity": {"enum": ["INVALID", "FAILED", "NOT_TESTED", "PLACEHOLDER"]}}, "required": ["validity"]},
            "then": {"required": ["missing_reason"], "properties": {"value": {"type": "null"}, "missing_reason": {"minLength": 1}}}
          }
        ]
      }
    },
    "observations": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["task", "evidence_ids"],
        "properties": {
          "task": {"type": "string", "minLength": 1},
          "evidence_ids": {"$ref": "#/$defs/nonemptyReferences"},
          "side": {"type": "string"},
          "score": {"type": "string"},
          "pain": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
          "raw_observation": {"type": "string"}
        }
      }
    },
    "conflicts": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["code", "state", "conflicting_sources"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "state": {"enum": ["OPEN", "RESOLVED", "DISPUTED", "DEFERRED"]},
          "conflicting_sources": {"$ref": "#/$defs/nonemptyReferences"},
          "resolution": {"type": "string"},
          "resolved_by": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time"}
        },
        "if": {"properties": {"state": {"const": "RESOLVED"}}, "required": ["state"]},
        "then": {"required": ["resolution", "resolved_by", "timestamp"]}
      }
    },
    "interpretations": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["statement", "evidence_ids", "reviewer_status"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "evidence_ids": {"$ref": "#/$defs/nonemptyReferences"},
          "contradictory_evidence_ids": {
            "type": "array", "maxItems": 64, "uniqueItems": true,
            "items": {"$ref": "#/$defs/sourceId"}
          },
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNDETERMINED"]},
          "reviewer_status": {"enum": ["DRAFT", "APPROVED", "REJECTED"]}
        }
      }
    },
    "qei": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["qei_id", "evidence_ids", "reviewer_status"],
        "properties": {
          "qei_id": {"$ref": "#/$defs/sourceId"},
          "evidence_ids": {"$ref": "#/$defs/nonemptyReferences"},
          "counter_evidence_ids": {
            "type": "array", "maxItems": 64, "uniqueItems": true,
            "items": {"$ref": "#/$defs/sourceId"}
          },
          "reviewer_status": {"enum": ["DRAFT", "APPROVED", "REJECTED"]}
        }
      }
    },
    "safety": {
      "type": "object",
      "required": ["red_flag_screen_status", "symptom_screen_status", "training_decision", "evidence_ids"],
      "properties": {
        "red_flag_screen_status": {"enum": ["SCREENED_NEGATIVE", "SCREENED_POSITIVE", "NOT_DOCUMENTED"]},
        "symptom_screen_status": {"enum": ["DOCUMENTED", "NOT_DOCUMENTED"]},
        "training_decision": {"enum": ["PENDING_REVIEW", "HOLD", "REFER", "CONDITIONAL_TRAINING"]},
        "evidence_ids": {"$ref": "#/$defs/nonemptyReferences"}
      }
    },
    "risks": {
      "type": "object",
      "required": ["medical_safety", "symptom", "movement_control", "growth_and_measurement"],
      "properties": {
        "medical_safety": {"$ref": "#/$defs/riskDomain"},
        "symptom": {"$ref": "#/$defs/riskDomain"},
        "movement_control": {"$ref": "#/$defs/riskDomain"},
        "growth_and_measurement": {"$ref": "#/$defs/riskDomain"}
      }
    },
    "kpis": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["task", "unit", "method", "next_review"],
        "properties": {
          "task": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "source_id": {"$ref": "#/$defs/sourceId"},
          "baseline": {"type": ["number", "null"]},
          "target": {"type": ["number", "null"]},
          "next_review": {"$ref": "#/$defs/date"},
          "reason_if_unavailable": {"type": "string"}
        },
        "if": {"not": {"required": ["baseline"], "properties": {"baseline": {"type": "number"}}}},
        "then": {"required": ["reason_if_unavailable"], "properties": {"reason_if_unavailable": {"minLength": 1}}}
      }
    },
    "review": {
      "type": "object",
      "required": ["qa_status", "source_revision", "reviewer"],
      "properties": {
        "qa_status": {"enum": ["PENDING", "BLOCKED", "APPROVED"]},
        "source_revision": {"type": "string", "pattern": "^[1-9][0-9]{0,17}$"},
        "reviewer": {"type": "string"},
        "signature": {"type": "string"},
        "report_revision": {"type": "string"},
        "immutable_output_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  },
  "$defs": {
    "riskDomain": {
      "type": "object",
      "required": ["status", "evidence_ids"],
      "properties": {
        "status": {"enum": ["ASSESSED", "UNKNOWN", "REVIEW_REQUIRED"]},
        "evidence_ids": {"$ref": "#/$defs/nonemptyReferences"}
      }
    },
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sourceId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "nonemptyReferences": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceId"}
    }
  }
}
