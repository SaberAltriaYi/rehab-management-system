# H5 development: optional Vite proxy target; leave VITE_REHAB_API_ORIGIN blank when using this proxy.
REHAB_DEV_PROXY_TARGET=

# App / WeChat Mini Program: set a device-accessible HTTPS API origin; H5 same-origin deployment may leave blank.
VITE_REHAB_API_ORIGIN=
VITE_REHAB_CAPTCHA_ENABLED=true

# Current patient auth only checks phone + patient number; keep disabled until security review is complete.
VITE_REHAB_PATIENT_LOGIN_ENABLED=false
