# 软件标识
VITE_APP_TITLE=康复管理系统
VITE_APP_VERSION=V1.0

# 项目本地运行端口号
VITE_PORT=80

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN=true

# 租户开关
VITE_APP_TENANT_ENABLE=true

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=true

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=true

# 康复系统 AI 开关：内部部署阶段保持关闭
VITE_REHAB_AI_ENABLED=false

# 统计功能默认关闭；如需启用，仅在本机或部署平台注入站点代码
VITE_APP_BAIDU_CODE =

# 不在源码中预填租户、账号或密码
VITE_APP_DEFAULT_LOGIN_TENANT =
VITE_APP_DEFAULT_LOGIN_USERNAME =
VITE_APP_DEFAULT_LOGIN_PASSWORD =

# API 加解密默认关闭；启用时必须通过未纳入版本控制的部署配置注入密钥
VITE_APP_API_ENCRYPT_ENABLE = false
VITE_APP_API_ENCRYPT_HEADER = X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM = AES
VITE_APP_API_ENCRYPT_REQUEST_KEY =
VITE_APP_API_ENCRYPT_RESPONSE_KEY =

# 地图密钥不进入源码仓库
VITE_BAIDU_MAP_KEY =
