# 工作室内部部署
NODE_ENV=production
VITE_DEV=false
VITE_APP_TITLE=康复管理系统
VITE_APP_VERSION=V1.0

# 同源部署，由 Nginx 将 /admin-api 转发到后端
VITE_BASE_URL=''
VITE_API_URL=/admin-api
VITE_BASE_PATH=/
VITE_UPLOAD_TYPE=server
VITE_OUT_DIR=dist-internal

# 内部成员登录
VITE_APP_TENANT_ENABLE=true
VITE_APP_CAPTCHA_ENABLE=true
VITE_APP_DOCALERT_ENABLE=false
VITE_APP_DEFAULT_LOGIN_TENANT='工作室内部'
VITE_APP_DEFAULT_LOGIN_USERNAME=''
VITE_APP_DEFAULT_LOGIN_PASSWORD=''
VITE_APP_BAIDU_CODE=''
VITE_BAIDU_MAP_KEY=''

# 内部版使用 HTTPS 与同源接口，源码中不内置 API 加密密钥
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_API_ENCRYPT_REQUEST_KEY=''
VITE_APP_API_ENCRYPT_RESPONSE_KEY=''

# 当前阶段保持 AI 关闭
VITE_REHAB_AI_ENABLED=false

VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false
