# Install under /etc/nginx/conf.d/ only AFTER cloud operator approval.
# Two DISTINCT public FQDN placeholders; Node Owner binds https://127.0.0.1:9444.
limit_req_zone $binary_remote_addr zone=rehab_activation_ip:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=rehab_owner_ip:10m rate=10r/m;

server {
    listen 443 ssl;
    server_name __ACTIVATION_FQDN__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/rehab-owner/tls/activation-fullchain.pem;
    ssl_certificate_key /etc/rehab-owner/tls/activation-key.pem;
    client_max_body_size 16k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location ^~ /license/v1/ {
        limit_req zone=rehab_activation_ip burst=12 nodelay;
        limit_req_status 429;
        proxy_pass https://127.0.0.1:9444;
        proxy_ssl_name owner-upstream.internal;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_trusted_certificate /etc/rehab-owner/tls/upstream-ca.pem;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
        proxy_connect_timeout 3s;
        proxy_request_buffering on;
    }
    location / { return 404; }
}

# Admin-only hostname requires client cert AND approved source ACL.
# The default ACL is closed; explicitly approve narrow private VPN CIDRs.
server {
    listen 443 ssl;
    server_name __OWNER_FQDN__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /etc/rehab-owner/tls/owner-fullchain.pem;
    ssl_certificate_key /etc/rehab-owner/tls/owner-key.pem;
    ssl_client_certificate /etc/rehab-owner/tls/owner-admin-client-ca.pem;
    ssl_verify_client on;
    ssl_verify_depth 2;
    client_max_body_size 16k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location ^~ /owner/ {
        include /etc/nginx/snippets/rehab-owner-admin-acl.conf;
        limit_req zone=rehab_owner_ip burst=8 nodelay;
        limit_req_status 429;
        proxy_pass https://127.0.0.1:9444;
        proxy_ssl_name owner-upstream.internal;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_trusted_certificate /etc/rehab-owner/tls/upstream-ca.pem;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 15s;
        proxy_connect_timeout 3s;
        proxy_request_buffering on;
    }
    location / { return 404; }
}
