# REVIEWED TEMPLATE ONLY. DO NOT enable until encrypted credentials,
# upstream TLS chain, cloud firewall and owner MFA have been provisioned.
[Unit]
Description=Rehab standalone owner licensing authority (private loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rehab-owner
Group=rehab-owner
WorkingDirectory=/opt/rehab-owner
Environment=NODE_ENV=production
Environment=REHAB_OWNER_REQUIRE_CREDENTIALS=1
Environment=REHAB_OWNER_DB_PATH=/var/lib/rehab-owner/owner.sqlite
Environment=REHAB_OWNER_PORT=9444
Environment=REHAB_OWNER_BROWSER_ORIGIN=https://__OWNER_FQDN__
LoadCredentialEncrypted=owner-vault-key:/etc/credstore.encrypted/rehab-owner-vault-key
LoadCredentialEncrypted=owner-tls-key:/etc/credstore.encrypted/rehab-owner-tls-key
LoadCredential=owner-tls-cert:/etc/rehab-owner/tls/owner-upstream-fullchain.pem
ExecStart=/usr/bin/node /opt/rehab-owner/desktop/license-control/cli.mjs serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0077
StateDirectory=rehab-owner
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
